 Positive Engagement (items 4, 7, & 12), (2) Revitalization (items, 1, 6, & 9).\n(3) Tranquillity (items 2, 5, & lo), and (4) Physical Exhaustion (items, 3, 8, & 11","ID":"NO_5zsZlGwYdX5NQvY","UserID":"UR_3klMX9YtgrEA7Hg","Timestamp":1661249554,"Removed":false},{"Message":"after each condition or in the end?","ID":"NO_8BTqdIzUHUHLa8C","UserID":"UR_3klMX9YtgrEA7Hg","Timestamp":1666602892,"Removed":false}],"UserStatuses":{"UR_3klMX9YtgrEA7Hg":"Expanded"},"ParentID":"QID95","ID":"NT_5iDB5f9GEkKe60K"}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"NT","PrimaryAttribute":"NT_6tXHlK2oz01bEW2","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"comfort rating scale (CRS): https:\/\/www.researchgate.net\/publication\/3998467_The_comfort_assessment_of_wearable_computers","ID":"NO_1GPHO2QjB482Xau","UserID":"UR_3klMX9YtgrEA7Hg","Timestamp":1659364581,"Removed":true},{"Message":"Fig. 3 are the questions, scale goes from 0 to 20 (slider)","ID":"NO_cFRbODfGMtzqdKe","UserID":"UR_3klMX9YtgrEA7Hg","Timestamp":1659364601,"Removed":true}],"UserStatuses":{"UR_3klMX9YtgrEA7Hg":"Expanded"},"ParentID":"QID19","ID":"NT_6tXHlK2oz01bEW2"}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"NT","PrimaryAttribute":"NT_78PzvPMg8m6z5TU","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"use this entry to implement logic","ID":"NO_9KVkpQIO5fwrJVs","UserID":"UR_3klMX9YtgrEA7Hg","Timestamp":1659361538,"Removed":true}],"UserStatuses":{"UR_3klMX9YtgrEA7Hg":"Expanded"},"ParentID":"QID25","ID":"NT_78PzvPMg8m6z5TU"}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"NT","PrimaryAttribute":"NT_79Brp0glmZS0voq","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Notes":[{"Message":"Verwende H\u00f6flichkeitsform","ID":"NO_1TcMt4Q5IZfYUm2","UserID":"UR_3klMX9YtgrEA7Hg","Timestamp":1659356125,"Removed":true},{"Message":"Verwende immer H\u00f6flichkeitsform","ID":"NO_eRiTp9kxKiPPxSS","UserID":"UR_3klMX9YtgrEA7Hg","Timestamp":1659356147,"Removed":true