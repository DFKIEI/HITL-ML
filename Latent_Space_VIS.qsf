lv4HMysgJfAOHhUvAcYMOVHRuoRDHlSh_uqepd51Fi33eNUB7WN7Yyy0fHgjg4wJTn62O5--Cl3aBq4Go788JALGfdojz76nS_UqDmZ9dgghDZRPwTayoK9jf8kypQJjg22gzVAxJzOBz5vMw\" style=\"margin-left:0px;margin-top:0px;\" width=\"183\" height=\"413\"><\/span><\/span>","DefaultChoices":false,"DataExportTag":"crs","QuestionID":"QID43","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"CRS: Comfort Rating Scales (https:\/\/www.researchgate.net\/publication\/3998467_The_comfort_assessme...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"interview guideline examples: e.g. expert interview for fitback:\u00a0https:\/\/docs.google.com\/document..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>interview guideline examples:<\/div><div><br><\/div><div>e.g. expert interview for fitback:&nbsp;https:\/\/docs.google.com\/document\/d\/1dEq37xRtOu28BGE3PqBQKjyPl0Sptaz7NAP529NR6TY\/edit?usp=sharing<br><\/div>","DefaultChoices":false,"DataExportTag":"Q44","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"interview guideline examples: e.g. expert interview for fitback:\u00a0https:\/\/docs.google.com\/document...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID44","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID45","SecondaryAttribute":"own ideas questionnaires\/intervew: (we actually ask these for both conditions) custom feedback qu...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>own ideas questionnaires\/intervew: (we actually ask these for both conditions)<br><\/div><div><br><\/div><div>custom feedback questions:<\/div><div>I could connect the shown feedback\/visualization to my exercise<\/div><div>The feedback helped me to understand how my body reacts to certain exercises =&gt; generalization =&gt; body awareness for general physical activity<\/div><div>The feedback allowed me to understand the effectiveness of the exercises<\/div><div>The feedback allowed me to evalute\/understand my performance (more in-depth)?<br><\/div><div>The feedback allowed me to judge my exhaustion level accurately<\/div><div>The feedback dictated how many sets I did<br><\/div><div>The feedback dictated how I performed the exercise<\/div><div>I did take notice of the feedback while exercising<\/div><div>I used the feedback to improve my exercise performance<\/div><div>The feedback did affect my exercise form<br><\/div><div>-&gt; use VAS (0-100),&nbsp;see adapted form here: *_feedback<\/div>","DefaultChoices":false,"DataExportTag":"questions_custom","QuestionID":"QID45","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"own ideas questionnaires\/intervew: (we actually ask these for both conditions) custom feedback qu...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID46","SecondaryAttribute":"self appraisal of performance pdf in the dropbox The Effects of a Mental Training Program on Juni...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>self appraisal of performance<\/div><div><br><\/div><div>pdf in the dropbox<br><\/div><div><br><\/div><div>The Effects of a Mental Training Program on Juniors Pre-Competitive Anxiety, Self-Confidence, and Tennis Performance:<br><\/div><div>https:\/\/www.tandfonline.com\/doi\/pdf\/10.1080\/10413200490437903?casa_token=TqlFtD711uoAAAAA:2VzZb3e0ChxUHP3Lk1Hf-Za4VvunT2L4NYVbAZW20YCLbYlrYc-_KfZGaPOqSUtrtHPNTqnWpCLa <span><a href=\"javascript:\"><img class=\"citavipicker\" identifier=\"10.1080\/10413200490437903?casa_token=TqlFtD711uoAAAAA:2VzZb3e0ChxUHP3Lk1Hf-Za4VvunT2L4NYVbAZW20YCLbYlrYc-_KfZGaPOqSUtrtHPNTqnWpCLa\" identifiertype=\"1\" src=\"data:image\/svg+xml;base64,\" style=\"border: 0px none!important;width: 16px!important;height: 16px!important;margin-left:1px !important;margin-right:1px !important;\" title=\"Titel anhand dieser DOI in Citavi-Projekt \u00fcbernehmen\" existsinproject=\"0\"><\/a><\/span> <span><a href=\"\"><img title=\"Titel anhand dieser DOI in Citavi-Projekt \u00fcbernehmen\" style=\"border: 0px none!important;width: 16px!important;height: 16px!important;margin-left:1px !important;margin-right:1px !important;\" src=\"data:image\/svg+xml;base64,\" class=\"citavipicker\"><\/a><\/span> <span><a href=\"\"><img class=\"citavipicker\" src=\"data:image\/svg+xml;base64,\" style=\"border: 0px none!important;width: 16px!important;height: 16px!important;margin-left:1px !important;margin-right:1px !important;\" title=\"Titel anhand dieser DOI in Citavi-Projekt \u00fcbernehmen\"><\/a><br><\/span><\/div><div><br><\/div><div>Specifically, each player was asked to appraise his or her performance on\na 5-point scale (1 being \u201cnot good at all\u201d and 5 being \u201cvery good\u201d) on the following aspects:\n1) his or her physical feelings; 2) quality of technique; 3) timing and rhythm; 4) concentration;\n5) amount of effort exerted; 6) mental attitude and thoughts; 7) level of self-confidence during\nthe match; and 8) comparison of his or her performance with what he or she was expected to\nplay, given the opponent. An overall performance score was obtained from the sum of all these\n8 items.<br><\/div>","DefaultChoices":false,"DataExportTag":"self_appraisal","QuestionID":"QID46","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"self appraisal of performance pdf in the dropbox The Effects of a Mental Training Program on Juni...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q47","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID47","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Age Gender Fitness profession\/direction\/ type of sport they do Used fitness applications\/sensors...","TertiaryAttribute":null,"Payload":{"QuestionText":"Age<br>Gender<br>Fitness profession\/direction\/ type of sport they do<br>Used fitness applications\/sensors with some examples (checkboxes + other)<br>-&gt; if yes, how experience in years<br>Experience (in years)<br>Experience with feedback for phys. activity (VAS 0-100)<br>","DefaultChoices":false,"DataExportTag":"demographics","QuestionID":"QID48","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Age Gender Fitness profession\/direction\/ type of sport they do Used fitness applications\/sensors...","ChoiceOrder":["4","5","6","7"],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"Which type(s) of dancing, rhythm related activity do you do?","Tertiar