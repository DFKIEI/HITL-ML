ceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID51"}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"2. How much time did you usually spend doing vigorous physical activities on one of those days?","TertiaryAttribute":null,"Payload":{"QuestionText":"2.\tHow much time did you usually spend doing vigorous physical activities on one of those days?","DefaultChoices":false,"DataExportTag":"Q52","QuestionID":"QID52","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"2. How much time did you usually spend doing vigorous physical activities on one of those days?","Choices":{"1":{"Display":"Hours per day"},"2":{"Display":"Minutes per day"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":null}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"Think about all the moderate activities that you did in the last 7 days. Moderate activities refe...","TertiaryAttribute":null,"Payload":{"QuestionText":"Think about all the moderate activities that you did in the last 7 days.  Moderate activities refer to activities that take moderate physical effort and make you breathe somewhat harder than normal.  Think only about those physical activities that you did for at least 10 minutes at a time.<br><br>During the last 7 days, on how many days did you do moderate physical activities like carrying light loads, bicycling at a regular pace, or doubles tennis?  Do not include walking.<br>","DefaultChoices":false,"DataExportTag":"Q53","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Think about all the moderate activities that you did in the last 7 days. Moderate activities refe...","Validation":{"Settings":{"ForceResponse":"OFF","Type":null}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID53","Choices":{"1":{"Display":"Days per week"}},"ChoiceOrder":[1]}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"How much time did you usually spend doing moderate physical activities on one of those days?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much time did you usually spend doing moderate physical activities on one of those days?","DefaultChoices":false,"DataExportTag":"Q54","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much time did you usually spend doing moderate physical activities on one of those days?","Choices":{"1":{"Display":"Hours per day"},"2":{"Display":"Minutes per day"},"3":{"Display":"Don't konw\/Not sure"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"OFF","Type":null}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID54"}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID55","SecondaryAttribute":"Think about the time you spent walking in the last 7 days. This includes at work and at home, wal...","TertiaryAttribute":null,"Payload":{"QuestionText":"Think about the time you spent walking in the last 7 days.  This includes at work and at home, walking to travel from place to place, and any other walking that you have done solely for recreation, sport, exercise, or leisure.<br><br>During the last 7 days, on how many days did you walk for at least 10 minutes at a time?  <br>","DefaultChoices":false,"DataExportTag":"Q55","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Think about the time you spent walking in the last 7 days. This includes at work and at home, wal...","Validation":{"Settings":{"ForceResponse":"OFF","Type":null}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID55","Choices":{"1":{"Display":"Days Per week"}},"ChoiceOrder":[1]}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"How much time did you usually spend walking on one of those days?","TertiaryAttribute":null,"Payload":{"QuestionText":"How much time did you usually spend walking on one of those days?","DefaultChoices":false,"DataExportTag":"Q56","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How much time did you usually spend walking on one of those days?","Validation":{"Settings":{"ForceResponse":"OFF","Type":null}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID56","Choices":{"1":{"Display":"Hours per day"},"2":{"Display":"Minutes per day"}},"ChoiceOrder":[1,2]}},{"SurveyID":"SV_9HbTfKIyuQpMsku","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"The last question is about the time you spent sitting on weekdays during the last 7 days. Include...","TertiaryAttribute":null,"Payload":{"QuestionText":"The last question is about the time you spent sitting on weekdays during the last 7 days.  Include time spent at work, at home, while doing course work and during leisure time.  This may include time spent sitting at a desk, visiting friends, reading, or sitting or lying down to watch television.<br><br>7.\tDuring the last 7 days, how much time did you spend sitting on a week day?<br>","DefaultChoices":false,"DataExportTag":"Q57","QuestionType":"TE","Selector":"FORM","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The last question is about the time you spent